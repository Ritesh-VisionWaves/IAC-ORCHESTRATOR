terraform {
  required_version = ">= 1.5.0, < 1.6.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = "~> 6.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }

  # The platform supplies the bucket and prefix of the workspace at init.
  backend "gcs" {}
}
